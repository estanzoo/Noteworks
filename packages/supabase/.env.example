# Supabase project (auto-injected into Edge Functions at runtime)
SUPABASE_URL=http://127.0.0.1:64321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# OAuth providers (referenced in config.toml via env(...))
APPLE_CLIENT_ID=
APPLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
