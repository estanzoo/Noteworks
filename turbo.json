{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "pipeline": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": ["dist/**", ".next/**"]
      },
      "dev": {
        "cache": false,
        "persistent": true
      },
      "lint": {
        "dependsOn": ["^lint"]
      },
      "test": {
        "dependsOn": ["^test"]
      },
      "db:migrate": {
        "cache": false
      },
      "types:generate": {
        "cache": false,
        "outputs": ["packages/shared-types/**/*.ts"]
      }
    }
  }